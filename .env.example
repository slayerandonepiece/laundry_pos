# Names only; never commit real values.
#
# Environments are separate Neon branches/projects, each with its own values:
#   dev   -> local .env / .env.local (git-ignored), Neon "laundry_pos" project, dev branch
#   stage -> Neon "laundry_pos" project, production branch (Vercel stage project env vars)
#   prod  -> Neon "klen_pos" project (Vercel production project env vars)
# Never run migrations, resets or seeds against stage/prod from a dev shell
# unless you pass that environment's URLs on purpose.

# Pooled connection (runtime) and direct connection (migrations).
DATABASE_URL=
DIRECT_URL=

# Signs sessions and invoice tokens. Required in production.
SESSION_SECRET=

# Super Admin bootstrap, read by `prisma db seed` (creates only the Super Admin).
# vercel-build seeds only when SEED_OWNER_PHONE is set.
SEED_OWNER_PHONE=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=

# Account deletion: grace period in days (default 90) and the secret Vercel Cron
# sends as `Authorization: Bearer $CRON_SECRET` to /api/cron/account-deletion.
DELETION_GRACE_DAYS=90
CRON_SECRET=

# Optional: block writes for organizations with no billing terms (default false).
MOBILE_BLOCK_TERMS_NOT_SET=false
