// Prisma schema for the Express Laundry backend.
// Money is stored as integer paise. Timestamps are stored in UTC; the app
// layer interprets dates in Asia/Kolkata to match existing UI semantics.
//
// Multi-tenant: every store-scoped table carries a storeId. A User's role is
// per-store (StoreMembership), not global — the same person can be OWNER of
// one store and EMPLOYEE of another. Super Admin is a platform-level flag on
// User, unscoped to any store.
//
// Note: `Store` is a temporary code and database name serving as the
// organization-level tenant during the outlet rollout. Outlets are currently
// schema-only foundation in this batch and are not yet used for authorization,
// records, reports, or UI.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  EMPLOYEE
}

enum ProductType {
  ITEM
  WEIGHT
}

enum WorkStatus {
  PENDING
  IN_PROGRESS
  READY
  DELIVERED
}

enum PaymentStage {
  PRE_ORDER
  POST_ORDER
  BOTH
}

enum MessageAttachment {
  NONE
  ORDER_SLIP_PDF
  INVOICE_PDF
}

enum StoreStatus {
  ACTIVE
  LOCKED
}

enum SubscriptionPaymentType {
  DEPOSIT
  RENEWAL
}

// Platform subscription billing only. Customer order payments snapshot the
// platform payment method's name into Payment.method.
enum PaymentMethod {
  CASH
  UPI
}

enum BillingCycle {
  ANNUAL
  HALF_YEARLY
  QUARTERLY
  MONTHLY
}

enum DocumentType {
  ORDER
  INVOICE
  RECEIPT
  QUOTATION
  CREDIT_NOTE
}

model User {
  id                 String   @id @default(cuid())
  name               String
  passwordHash       String
  active             Boolean  @default(true)
  // Platform-level access, unscoped to any store. Not the same thing as
  // owning a store — see StoreMembership for per-store roles.
  isSuperAdmin       Boolean  @default(false)
  credentialVersion  Int      @default(1)
  mustChangePassword Boolean  @default(false)
  // Global to the person (not a store's own contact info — see Store.email/
  // Store.phone, which represent the store, not the owner). Phone is the
  // normalized, required login identifier; email remains optional.
  email              String?
  phone              String   @unique
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  sessions                            Session[]
  statusEvents                        StatusEvent[]
  memberships                         StoreMembership[]
  onboardedStores                     Store[]                       @relation("StoreOnboardedBy")
  recordedPayments                    SubscriptionPayment[]         @relation("SubscriptionPaymentRecordedBy")
  outletMemberships                   OutletMembership[]
  createdOutlets                      Outlet[]                      @relation("OutletCreatedBy")
  auditLogs                           AuditLog[]
  updatedOrganizationMessageTemplates OrganizationMessageTemplate[] @relation("OrganizationMessageTemplateUpdatedBy")
  importBatchesCreated                ImportBatch[]                 @relation("ImportBatchCreatedBy")
  importBatchesUndone                 ImportBatch[]                 @relation("ImportBatchUndoneBy")

  @@index([active])
  @@index([isSuperAdmin])
  @@map("users")
}

model Session {
  id                String   @id @default(cuid())
  token             String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialVersion Int
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthThrottle {
  key             String    @id
  count           Int
  windowStartedAt DateTime
  blockedUntil    DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([updatedAt])
  @@map("auth_throttle")
}

// Temporary code/database name serving as the organization-level tenant during
// the outlet rollout. Outlets are schema-only in this batch and are not yet used
// for authorization, records, reports, or UI.
model Store {
  id                   String      @id @default(cuid())
  name                 String
  address              String      @default("")
  phone                String      @default("")
  email                String      @default("")
  orgCode              String      @unique @default(dbgenerated("lpad((nextval('\"stores_orgCode_seq\"'::regclass))::text, 3, '0'::text)"))
  orderSeqBase         BigInt      @default(1000000001)
  status               StoreStatus @default(ACTIVE)
  onboardedAt          DateTime    @default(now())
  onboardedById        String?
  onboardedBy          User?       @relation("StoreOnboardedBy", fields: [onboardedById], references: [id], onDelete: SetNull)
  // Soft delete — a store is archived, never hard-deleted, so its order and
  // payment history survives. Null means active/not archived.
  deletedAt            DateTime?
  accessGrantedUntil   DateTime?   @db.Date
  // Protected app-store review organization: never wiped by the deletion job,
  // never subscription-locked, and pending deletion requests auto-restore.
  isReviewDemo         Boolean     @default(false)
  // Set while an ORGANIZATION-scope AccountDeletionRequest is PENDING; locks
  // the organization for everyone with blockedReason 'deletion_pending'.
  deletionScheduledFor DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  memberships                 StoreMembership[]
  subscription                Subscription?
  payments                    SubscriptionPayment[]
  products                    Product[]
  orders                      Order[]
  orderInvoices               OrderInvoice[]
  expenses                    Expense[]
  recurringExpenseSeries      RecurringExpenseSeries[]
  outlets                     Outlet[]
  organizationPaymentMethods  OrganizationPaymentMethod[]
  messageTemplates            OrganizationMessageTemplate[]
  auditLogs                   AuditLog[]
  orderPayments               Payment[]                     @relation("StoreOrderPayments")
  storeStatusEvents           StatusEvent[]                 @relation("StoreStatusEvents")
  dailyOutletSummaries        DailyOutletSummary[]
  dailyOutletServiceSummaries DailyOutletServiceSummary[]
  documentCounters            DocumentCounter[]
  importBatches               ImportBatch[]

  @@index([deletedAt])
  @@map("stores")
}

model DocumentCounter {
  storeId   String
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  docType   DocumentType
  fy        Int
  nextValue BigInt
  updatedAt DateTime     @updatedAt

  @@id([storeId, docType, fy])
  @@index([storeId])
  @@map("document_counters")
}

model StoreMembership {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeId        String
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  role           Role
  // Per-store access flag — an employee can be deactivated at one store
  // without affecting a membership they still hold at another (see
  // .agents/2026-09-brainstorm-plan.md Item 1). Deliberately independent of
  // User.active/credentialVersion: moving between stores never touches
  // credentials. Defaults true so existing rows (migrated before this
  // column existed) come in active.
  active         Boolean  @default(true)
  idempotencyKey String?
  createdAt      DateTime @default(now())

  @@unique([userId, storeId])
  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@map("store_memberships")
}

model SubscriptionPlan {
  id                     String       @id @default(cuid())
  name                   String
  depositAmount          Int // paise
  annualFeeAmount        Int // paise
  billingCycle           BillingCycle @default(ANNUAL)
  // When true, organizations on this plan skip the deposit.
  depositWaivedByDefault Boolean      @default(false)
  defaultTrialDays       Int?
  notes                  String       @default("")
  // Archived, never hard-deleted — plans can be in use by active
  // subscriptions (see archivePlan()'s reassign-or-detach flow).
  archivedAt             DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id      String            @id @default(cuid())
  storeId String            @unique
  store   Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  // Nullable — a subscription can be fully custom/negotiated with no plan
  // attached (e.g. a waived deposit), not every store needs a library plan.
  planId  String?
  plan    SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  // Per-organization price overrides, in paise. NULL means "follow the plan":
  // the effective amount is read live from the plan (see effectiveSubscriptionTerms).
  // A value is a custom negotiated price, or the deposit frozen once it is paid.
  depositAmount   Int?
  depositPaidAt   DateTime? @db.Date
  annualFeeAmount Int?
  // Manual per-store discount, independent of any plan's list price.
  discountAmount  Int       @default(0) // paise
  // Null until a first payment is recorded. Only an explicit, past date locks
  // the store — a never-set subscription is never auto-locked.
  paidThroughDate DateTime? @db.Date
  trialStartsAt   DateTime? @db.Date
  trialEndsAt     DateTime? @db.Date
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([paidThroughDate])
  @@map("subscriptions")
}

model SubscriptionPayment {
  id           String                  @id @default(cuid())
  storeId      String
  store        Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoiceSeq   Int                     @unique @default(autoincrement())
  type         SubscriptionPaymentType
  amount       Int // paise
  // Nullable — payments recorded before this column existed have no known
  // method on file.
  method       PaymentMethod?
  paidAt       DateTime                @db.Date
  coversFrom   DateTime?               @db.Date
  coversTo     DateTime?               @db.Date
  notes        String                  @default("")
  // Free-text payment reference (e.g. a UPI transaction ID), optional.
  reference    String                  @default("")
  // Which Super Admin was logged in when this payment was recorded. Nullable
  // since payments recorded before this column existed have no known actor.
  recordedById String?
  recordedBy   User?                   @relation("SubscriptionPaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt    DateTime                @default(now())

  @@index([storeId])
  @@map("subscription_payments")
}

model Product {
  id        String        @id @default(cuid())
  storeId   String
  store     Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name      String
  category  String
  type      ProductType
  active    Boolean       @default(true)
  price     Int? // paise; set when type = ITEM
  extra     Int? // paise per extra unit beyond slabs; set when type = WEIGHT
  slabs     ProductSlab[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  orderLines OrderLine[]

  @@index([storeId])
  @@map("products")
}

model ProductSlab {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  limit     Decimal @db.Decimal(10, 3) // weight limit, e.g. kg
  price     Int // paise at this slab

  @@index([productId])
  @@map("product_slabs")
}

model Order {
  id              String       @id @default(cuid())
  storeId         String
  store           Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderNumber     BigInt       @default(autoincrement())
  idempotencyKey  String?
  // Client-generated id for orders created in the mobile app (offline-first).
  // Null for orders created on the web.
  offlineId       String?
  // Opaque token for the public order-slip link; created the first time a slip is shared.
  slipToken       String?      @unique
  // Entered through the Super Admin history import rather than punched at a counter.
  isImported      Boolean      @default(false)
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  customerName    String
  phone           String
  // Calendar dates (Asia/Kolkata), not instants — stored without a time
  // component so no server timezone conversion can shift the day.
  orderDate       DateTime     @default(now()) @db.Date
  dueDate         DateTime     @db.Date
  completedAt     DateTime?    @db.Date
  status          WorkStatus   @default(PENDING)
  notes           String       @default("")
  legacyCancelled Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  outletId        String?
  outlet          Outlet?      @relation(fields: [outletId], references: [id], onDelete: SetNull)

  lines        OrderLine[]
  payments     Payment[]
  statusEvents StatusEvent[]
  invoice      OrderInvoice?

  @@unique([storeId, offlineId])
  @@unique([storeId, idempotencyKey])
  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([status])
  @@index([dueDate])
  @@index([storeId, outletId, orderDate])
  @@index([outletId, status])
  @@index([outletId, dueDate])
  @@index([orderDate])
  @@index([updatedAt])
  @@index([storeId, phone, orderDate])
  @@index([importBatchId])
  @@map("orders")
}

// A store's customer-facing invoice for a laundry order — entirely separate
// from SubscriptionPayment.invoiceSeq (platform -> store owner billing).
// Deliberately thin: no snapshotted line items/amounts of its own — it just
// pins a stable, never-reassigned invoice number to an order and always
// reads the order's own (already-immutable) lines/payments for content, so
// there's nothing here to drift out of sync with the order it documents.
// Created lazily — get-or-create on first view/download/print/share, not at
// order-creation time — so no invoice (and no consumed number) exists for an
// order nobody ever asked to see the invoice for.
model OrderInvoice {
  id            String   @id @default(cuid())
  invoiceSeq    Int      @unique @default(autoincrement())
  invoiceNumber String
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  storeId       String
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  accessToken   String   @unique
  generatedAt   DateTime @default(now())
  outletId      String?
  outlet        Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@unique([storeId, invoiceNumber])
  @@index([storeId])
  @@index([storeId, outletId])
  @@map("order_invoices")
}

model OrderLine {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name      String // product name snapshot at time of sale
  quantity  Decimal  @db.Decimal(10, 3)
  unit      String
  amount    Int // paise, snapshot line total

  @@index([orderId])
  @@map("order_lines")
}

model Payment {
  id                      String                 @id @default(cuid())
  orderId                 String
  order                   Order                  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount                  Int // paise
  method                  String
  paidAt                  DateTime               @default(now()) @db.Date // calendar date (Asia/Kolkata), not an instant
  clientActionId          String?                @unique
  receiptNumber           String?
  storeId                 String?
  store                   Store?                 @relation("StoreOrderPayments", fields: [storeId], references: [id], onDelete: Cascade)
  outletId                String?
  outlet                  Outlet?                @relation(fields: [outletId], references: [id], onDelete: SetNull)
  platformPaymentMethodId String?
  platformPaymentMethod   PlatformPaymentMethod? @relation(fields: [platformPaymentMethodId], references: [id], onDelete: SetNull)

  @@unique([storeId, receiptNumber])
  @@index([orderId])
  @@index([storeId, outletId, paidAt])
  @@index([outletId])
  @@index([platformPaymentMethodId])
  @@map("payments")
}

model StatusEvent {
  id       String     @id @default(cuid())
  orderId  String
  order    Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status   WorkStatus
  at       DateTime   @default(now())
  byUserId String?
  byUser   User?      @relation(fields: [byUserId], references: [id], onDelete: SetNull)
  storeId  String?
  store    Store?     @relation("StoreStatusEvents", fields: [storeId], references: [id], onDelete: Cascade)
  outletId String?
  outlet   Outlet?    @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([storeId, outletId, at])
  @@index([outletId])
  @@map("status_events")
}

model RecurringExpenseSeries {
  id        String   @id @default(cuid())
  storeId   String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  title     String
  category  String
  amount    Int // paise
  dueDay    Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  outletId  String?
  outlet    Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)

  occurrences Expense[]

  @@index([storeId])
  @@index([storeId, outletId])
  @@map("recurring_expense_series")
}

model Expense {
  id             String                  @id @default(cuid())
  storeId        String
  store          Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  idempotencyKey String?
  title          String
  category       String
  amount         Int // paise
  dueDate        DateTime                @db.Date
  paidAt         DateTime?               @db.Date
  seriesId       String?
  series         RecurringExpenseSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)
  // 'YYYY-MM', set only on series-generated occurrences. With seriesId this
  // gives a retry-safe unique key so generating occurrences twice (e.g. two
  // concurrent listExpenses calls) can't create duplicate months.
  periodMonth    String?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  outletId       String?
  outlet         Outlet?                 @relation(fields: [outletId], references: [id], onDelete: SetNull)

  @@unique([seriesId, periodMonth])
  @@unique([storeId, idempotencyKey])
  @@index([storeId])
  @@index([dueDate])
  @@index([storeId, outletId, dueDate])
  @@index([outletId])
  @@map("expenses")
}

enum OutletStatus {
  ACTIVE
  CLOSED
  RELOCATED
}

// Schema-only foundation for future organization -> outlet rollout.
// Not yet used for authorization, records, reports, or UI.
model Outlet {
  id          String       @id @default(cuid())
  outletCode  String       @unique
  storeId     String
  store       Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  displayName String
  address     String       @default("")
  phone       String       @default("")
  status      OutletStatus @default(ACTIVE)
  createdById String?
  createdBy   User?        @relation("OutletCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  openedAt    DateTime     @default(now())
  closedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  memberships            OutletMembership[]
  auditLogs              AuditLog[]
  orders                 Order[]
  payments               Payment[]
  expenses               Expense[]
  recurringExpenseSeries RecurringExpenseSeries[]
  orderInvoices          OrderInvoice[]
  importBatches          ImportBatch[]
  statusEvents           StatusEvent[]
  dailySummaries         DailyOutletSummary[]
  dailyServiceSummaries  DailyOutletServiceSummary[]

  @@index([storeId])
  @@map("outlets")
}

model OutletMembership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  outletId  String
  outlet    Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([userId, outletId])
  @@index([outletId])
  @@index([userId])
  @@map("outlet_memberships")
}

model PlatformPaymentMethod {
  id               String       @id @default(cuid())
  code             String       @unique
  name             String
  active           Boolean      @default(true)
  enabledByDefault Boolean      @default(false)
  // The method's stage. Authoritative for every organization (read via effectiveStage); never copied.
  defaultStage     PaymentStage @default(BOTH)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organizationPaymentMethods OrganizationPaymentMethod[]
  payments                   Payment[]

  @@map("platform_payment_methods")
}

model OrganizationPaymentMethod {
  id                      String                @id @default(cuid())
  storeId                 String
  store                   Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  platformPaymentMethodId String
  platformPaymentMethod   PlatformPaymentMethod @relation(fields: [platformPaymentMethodId], references: [id], onDelete: Restrict)
  enabled                 Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([storeId, platformPaymentMethodId])
  @@index([storeId])
  @@map("organization_payment_methods")
}

model PlatformMessageTemplate {
  id                String            @id @default(cuid())
  statusKey         WorkStatus        @unique
  body              String
  defaultEnabled    Boolean           @default(false)
  defaultAttachment MessageAttachment @default(NONE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@map("platform_message_templates")
}

model OrganizationMessageTemplate {
  id          String            @id @default(cuid())
  storeId     String
  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  statusKey   WorkStatus
  body        String
  enabled     Boolean           @default(false)
  attachment  MessageAttachment @default(NONE)
  updatedById String?
  updatedBy   User?             @relation("OrganizationMessageTemplateUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([storeId, statusKey])
  @@index([storeId])
  @@index([updatedById])
  @@map("organization_message_templates")
}

model AuditLog {
  id         String   @id @default(cuid())
  storeId    String?
  store      Store?   @relation(fields: [storeId], references: [id], onDelete: SetNull)
  outletId   String?
  outlet     Outlet?  @relation(fields: [outletId], references: [id], onDelete: SetNull)
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  beforeJson Json?
  afterJson  Json?
  createdAt  DateTime @default(now())

  @@index([storeId, createdAt])
  @@index([outletId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

model DailyOutletSummary {
  id                      String   @id @default(cuid())
  storeId                 String
  store                   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  outletId                String
  outlet                  Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  businessDate            DateTime @db.Date
  ordersCreatedCount      Int      @default(0)
  ordersCompletedCount    Int      @default(0)
  grossOrderAmount        Int      @default(0)
  paymentsCollectedAmount Int      @default(0)
  expensesAmount          Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([storeId, outletId, businessDate])
  @@index([storeId, businessDate])
  @@index([outletId, businessDate])
  @@map("daily_outlet_summaries")
}

model DailyOutletServiceSummary {
  id           String   @id @default(cuid())
  storeId      String
  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  outletId     String
  outlet       Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  serviceName  String
  businessDate DateTime @db.Date
  piecesCount  Int      @default(0)
  orderCount   Int      @default(0)
  amount       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([storeId, outletId, serviceName, businessDate])
  @@index([storeId, businessDate])
  @@index([outletId, businessDate])
  @@map("daily_outlet_service_summaries")
}

// Platform-managed information/maintenance notices; empty storeIds means all organizations.
model WorkspaceAnnouncement {
  id          String   @id @default(cuid())
  message     String   @db.VarChar(500)
  audience    String   @default("store") @db.VarChar(16)
  tone        String   @default("info") @db.VarChar(16)
  storeIds    String[] @default([])
  actionLabel String?  @db.VarChar(60)
  actionHref  String?  @db.VarChar(500)
  published   Boolean  @default(false)
  revision    Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
  @@map("workspace_announcements")
}

enum DeletionScope {
  ORGANIZATION
  SELF
}

enum DeletionStatus {
  PENDING
  RESTORED
  COMPLETED
}

enum DeletionChannel {
  MOBILE
  WEB
  SUPPORT
}

// Proof that a deletion request was honoured. Deliberately NO foreign keys and
// NO personal fields (no phone, name, email, organization name — not even
// hashed): opaque ids, role and dates only, so rows survive the permanent wipe.
model AccountDeletionRequest {
  id             String          @id @default(cuid())
  userId         String
  organizationId String?
  role           Role
  scope          DeletionScope
  status         DeletionStatus  @default(PENDING)
  requestedAt    DateTime        @default(now())
  scheduledFor   DateTime
  restoredAt     DateTime?
  completedAt    DateTime?
  requestedVia   DeletionChannel

  @@index([status, scheduledFor])
  @@index([userId])
  @@index([organizationId])
  @@map("account_deletion_requests")
}

// Billing facts retained after an organization is wiped, for tax/accounting
// retention only. No FKs; no name, phone, email, reference, notes or recorder.
model BillingRecordArchive {
  id             String                  @id @default(cuid())
  organizationId String
  invoiceSeq     Int                     @unique
  type           SubscriptionPaymentType
  amount         Int // paise
  method         PaymentMethod?
  paidAt         DateTime                @db.Date
  coversFrom     DateTime?               @db.Date
  coversTo       DateTime?               @db.Date
  archivedAt     DateTime                @default(now())

  @@map("billing_record_archive")
}

enum ImportBatchStatus {
  IMPORTED
  UNDONE
}

// One Super Admin history import: past delivered-and-paid orders for one outlet on
// one date. Kept after an undo (status UNDONE) as the audit record of what happened.
model ImportBatch {
  id             String            @id @default(cuid())
  storeId        String
  store          Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  outletId       String
  outlet         Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?             @relation("ImportBatchCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  undoneById     String?
  undoneBy       User?             @relation("ImportBatchUndoneBy", fields: [undoneById], references: [id], onDelete: SetNull)
  // Client-generated per import attempt so a retry or double click cannot import twice.
  idempotencyKey String
  businessDate   DateTime          @db.Date
  paymentMethod  String
  rowCount       Int
  orderCount     Int
  totalAmount    Int // paise
  status         ImportBatchStatus @default(IMPORTED)
  createdAt      DateTime          @default(now())
  finishedAt     DateTime?
  undoneAt       DateTime?
  orders         Order[]

  @@unique([storeId, idempotencyKey])
  @@index([storeId, createdAt])
  @@index([outletId])
  @@map("import_batches")
}

// Per-platform app-update advisory thresholds (X-Update-Level header on
// /api/v1). One row per platform ("ios" | "android"); a null column means
// unset, which always yields level "none". Editable by Super Admin.
model AppUpdateSetting {
  platform          String   @id
  softMinVersion    String?
  urgentMinVersion  String?
  updatedAt         DateTime @updatedAt
  updatedById       String?

  @@map("app_update_settings")
}
